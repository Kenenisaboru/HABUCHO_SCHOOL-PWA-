PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/habucho_school
# Generate a secure JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_WITH_COMMAND_ABOVE
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_SSL=false
LOG_LEVEL=debug
# Optional. Render persistent disk example: /var/data/uploads
# UPLOAD_DIR=
# Optional private directory for admissions documents; keep it off public static paths.
# PRIVATE_UPLOAD_DIR=

# Optional SMTP configuration for score-report email
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
